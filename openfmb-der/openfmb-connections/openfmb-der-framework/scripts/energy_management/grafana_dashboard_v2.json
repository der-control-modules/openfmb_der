      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "influxdb"},
      "targets": [
        {
          "datasource": {"type": "influxdb"},
          "rawQuery": true,
          "query": "SELECT last(\"value\") FROM \"soc\" WHERE (\"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783')",
          "resultFormat": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 20},
              {"color": "green", "value": 50},
              {"color": "blue", "value": 80}
            ]
          }
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
