      "targets": [
        {
          "datasource": {"type": "influxdb"},
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"power\" WHERE (\"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
