{
  "id": null,
  "uid": "openfmb-der-live",
  "title": "OpenFMB DER Integration Dashboard",
  "tags": ["openfmb", "der", "integration"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solar PV Power",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "influxdb"},
      "targets": [
        {
          "datasource": {"type": "influxdb"},
          "rawQuery": true,
          "query": "SELECT mean(\"value\") FROM \"power\" WHERE (\"mrid\" = 'solar-1') AND $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "alias": "Solar Power",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {"fixedColor": "yellow", "mode": "fixed"},
          "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Battery ESS Power",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
