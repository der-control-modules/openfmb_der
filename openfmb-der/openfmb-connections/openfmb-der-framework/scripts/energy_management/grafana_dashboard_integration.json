{
  "id": null,
  "uid": null,
  "title": "OpenFMB DER Integration Dashboard",
  "tags": ["openfmb", "der", "integration"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 36,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Solar PV Power",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"solar\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "Solar Power (W)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {"fixedColor": "yellow", "mode": "fixed"},
          "custom": {"drawStyle": "line", "fillOpacity": 20}
        }
      }
    },
    {
      "id": 2,
      "title": "Battery ESS Power",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"ess\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "ESS Power (W)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {"fixedColor": "blue", "mode": "fixed"},
          "custom": {"drawStyle": "line", "fillOpacity": 20}
        }
      }
    },
    {
      "id": 3,
      "title": "Battery State of Charge",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT last(\"soc\") FROM \"ess\"",
          "alias": "SOC %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 20},
              {"color": "green", "value": 50},
              {"color": "blue", "value": 80}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Grid Meter Power",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"meter\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "Grid Power (W)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {"fixedColor": "green", "mode": "fixed"},
          "custom": {"drawStyle": "line", "fillOpacity": 20}
        }
      }
    },
    {
      "id": 5,
      "title": "System Overview",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"solar\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "Solar",
          "refId": "A"
        },
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"ess\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "Battery",
          "refId": "B"
        },
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT mean(\"power\") FROM \"meter\" WHERE $timeFilter GROUP BY time($__interval)",
          "alias": "Grid",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {"drawStyle": "line", "fillOpacity": 10}
        }
      }
    },
    {
      "id": 6,
      "title": "Current Values",
      "type": "stat",
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT last(\"power\") FROM \"solar\"",
          "alias": "Solar Power",
          "refId": "A"
        },
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT last(\"power\") FROM \"ess\"",
          "alias": "ESS Power",
          "refId": "B"
        },
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT last(\"soc\") FROM \"ess\"",
          "alias": "Battery SOC",
          "refId": "C"
        },
        {
          "datasource": {"type": "influxdb", "uid": "df8a3lxdq5zb4a"},
          "query": "SELECT last(\"power\") FROM \"meter\"",
          "alias": "Grid Power",
          "refId": "D"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal"
      }
    }
  ]
}
