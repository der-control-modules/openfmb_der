{
  "dashboard": {
    "id": null,
    "title": "OpenFMB DER Battery Monitor - Working",
    "tags": ["openfmb", "der", "battery"],
    "timezone": "browser",
    "refresh": "5s",
    "schemaVersion": 36,
    "version": 1,
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Battery Power (W)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": {"type": "influxdb"},
            "query": "SELECT mean(\"value\") FROM \"power\" WHERE \"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783' AND $timeFilter GROUP BY time($__interval)",
            "alias": "Battery Power",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "pointSize": 3,
              "spanNulls": false,
              "fillOpacity": 0,
              "gradientMode": "none"
            }
          }
        },
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "visible",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "State of Charge (%)",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "datasource": {"type": "influxdb"},
            "query": "SELECT last(\"value\") FROM \"soc\" WHERE \"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783'",
            "alias": "SOC",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 20},
                {"color": "green", "value": 50},
                {"color": "blue", "value": 80}
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 3,
        "title": "Current Power Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "datasource": {"type": "influxdb"},
            "query": "SELECT last(\"value\") FROM \"power\" WHERE \"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783'",
            "alias": "Current Power",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": -1000},
                {"color": "yellow", "value": -100},
                {"color": "green", "value": 0},
                {"color": "blue", "value": 100}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto",
          "orientation": "horizontal",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          }
        }
      },
      {
        "id": 4,
        "title": "Power Trend (Last Hour)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
        "targets": [
          {
            "datasource": {"type": "influxdb"},
            "query": "SELECT mean(\"value\") FROM \"power\" WHERE \"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783' AND $timeFilter GROUP BY time(1m)",
            "alias": "Battery Power",
            "refId": "A"
          },
          {
            "datasource": {"type": "influxdb"},
            "query": "SELECT mean(\"value\") FROM \"soc\" WHERE \"mrid\" = 'a6a7f5f4-2601-45d2-9445-ca147f32c783' AND $timeFilter GROUP BY time(1m)",
            "alias": "SOC %",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "pointSize": 2,
              "spanNulls": false,
              "fillOpacity": 10,
              "gradientMode": "none"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Battery Power"},
              "properties": [
                {"id": "unit", "value": "watt"},
                {"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "SOC %"},
              "properties": [
                {"id": "unit", "value": "percent"},
                {"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}
              ]
            }
          ]
        }
      }
    ]
  }
}